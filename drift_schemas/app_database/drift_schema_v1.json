  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"key\" TEXT NULL UNIQUE, \"custom_name\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "encrypted_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"encrypted_files\" (\"id\" TEXT NOT NULL, \"format_version\" INTEGER NOT NULL, \"plaintext_bytes\" INTEGER NOT NULL, \"ciphertext_bytes\" INTEGER NOT NULL, \"fingerprint\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"documents\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"file_id\" TEXT NOT NULL REFERENCES encrypted_files (id) ON DELETE RESTRICT, \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
