<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window (before Flutter's first frame): brand navy + logo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/docsafe_navy</item>
        <item name="android:navigationBarColor">@color/docsafe_navy</item>
    </style>
    <!-- Behind the Flutter UI while it initializes / runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/docsafe_navy</item>
    </style>
</resources>
