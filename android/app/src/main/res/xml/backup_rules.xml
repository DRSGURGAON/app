<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Encrypted files are useless without device-bound Keystore keys,
     and metadata must not leave the device, so nothing is backed up. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
