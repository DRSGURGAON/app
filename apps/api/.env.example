# ---- Copy to .env and fill in. NEVER commit .env. Placeholders only. ----
NODE_ENV=development
PORT=4000
# Public URL of this API (used in links to uploaded images)
PUBLIC_BASE_URL=http://localhost:4000

DATABASE_URL=postgres://ardh:CHANGE_ME@127.0.0.1:5432/ardh_store

# Long random strings (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM
OTP_HMAC_SECRET=CHANGE_ME_LONG_RANDOM

# Comma-separated browser origins allowed to call the API (admin panel domain)
CORS_ORIGINS=http://localhost:5173

# ---- OTP ----  provider: msg91 | mock   (mock is REFUSED when NODE_ENV=production)
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Payments ----  provider: razorpay | mock (mock is REFUSED in production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# sandbox | live  (live is blocked unless the key id starts with rzp_live_)
PAYMENT_MODE=sandbox

# ---- Distance / routing ----  provider: osrm | google | none
ROUTING_PROVIDER=none
OSRM_BASE_URL=
GOOGLE_MAPS_API_KEY=

# ---- Push notifications (Firebase Cloud Messaging HTTP v1) ----
FCM_PROJECT_ID=
# Path to the service-account JSON on the server (never in the repo)
FCM_SERVICE_ACCOUNT_FILE=

# ---- Image storage ----  driver: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Serve the built admin panel from this API (path to apps/admin/dist). Leave empty to disable.
ADMIN_DIST_DIR=

# Run pending SQL migrations automatically at start-up (safe: checksummed, idempotent). Optional; you can run `npm run migrate` instead.
AUTO_MIGRATE=false

# Used only by `npm run create-admin` (first owner account). Do not keep the password in .env afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner
